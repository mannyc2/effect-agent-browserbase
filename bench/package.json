    "effect": "4.0.0",
    "effect-browser": "workspace:*",
    "effect-browserbase": "workspace:*",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  }
