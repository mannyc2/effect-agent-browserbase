{
  "name": "demos",
  "private": true,
  "description": "Recorded effect-browser runs, replayed with the pointer, keys, agent turns and grades.",
  "type": "module",
  "scripts": {
    "build": "vp build",
    "check": "tsc --noEmit -p tsconfig.json",
    "dev": "vp dev",
    "pack": "node --conditions=@effect-browser/source pack.ts",
    "test": "vp test --run"
  },
  "dependencies": {
    "effect": "4.0.0",
