{
  // Lint policy for the packages this repository owns. Acceptance
  // runs Oxlint with this file alone and denies warnings, so every rule here, including the
  // preset's warnings, blocks. An exception names its reason in the directive:
  //   // oxlint-disable-next-line <rule> -- <why this site is an exception>
  // Override globs resolve from this directory, hence their leading `**/`.
  "$schema": "../node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["../node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "vitest", "effecttsgo"],
  // Effect Agent's own lint plugins, adapted into ./plugins.
  "jsPlugins": [
    { "name": "stylistic", "specifier": "./plugins/style.js" },
    { "name": "exports", "specifier": "./plugins/exports.ts" },
    { "name": "directives", "specifier": "./plugins/directives.ts" },
    { "name": "vite-plus", "specifier": "vite-plus/oxlint-plugin" }
  ],
  "options": { "typeAware": true },
  "rules": {
    // Carried over from Effect Agent's root config, which used to lint these packages.
    "eqeqeq": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": ["error", { "preferInline": true }],
    "import/no-self-import": "error",
    "stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "prev": ["const", "let", "var", "multiline-export"], "next": "*" },
      {
        "blankLine": "always",
        "prev": "*",
        "next": ["multiline-const", "multiline-let", "multiline-var", "multiline-export"]
      },
      {
        "blankLine": "any",
        "prev": ["singleline-const", "singleline-let", "singleline-var"],
        "next": ["singleline-const", "singleline-let", "singleline-var"]
      },
      { "blankLine": "always", "prev": "*", "next": "return" }
    ],
    "typescript/consistent-type-imports": [
      "error",
      { "fixStyle": "inline-type-imports", "prefer": "type-imports" }
    ],
    "typescript/no-explicit-any": "error",
    // Rebuilding a Schema class instance through `make` spreads it, and code-point limits spread
    // strings, both on purpose. Effect Agent turns this rule off for the same reason.
    "typescript/no-misused-spread": "off",
    "unicorn/prefer-node-protocol": "error",
    "vite-plus/prefer-vite-plus-imports": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-identical-title": "error",
    // It does not recognise `it.effect` as a test, so it reports every assertion inside one.
    "vitest/no-standalone-expect": "off",
    // Vitest's `expect` takes a message as its second argument.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],

    // Don't panic: a failure is a typed value, not an unchecked escape.
    "typescript/no-non-null-assertion": "error",
    "typescript/only-throw-error": "error",
    // Re-rejecting a caught `unknown` forwards the original failure unchanged.
    "typescript/prefer-promise-reject-errors": ["error", { "allowThrowingUnknown": true }],

    // Don't fail silently: no dropped work, swallowed failure or assertion-free test.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "eslint/preserve-caught-error": "error",
    "eslint/no-empty": "error",
    "effecttsgo/any-unknown-in-error-context": "error",
    "vitest/expect-expect": "error",
    "vitest/no-conditional-expect": "error",
    "vitest/no-conditional-tests": "error",
    "vitest/no-disabled-tests": "error",

    // Don't do bad async things: keep interruption, supervision and settlement explicit.
    "typescript/return-await": "error",
    "eslint/no-promise-executor-return": "error",
    "promise/no-callback-in-promise": "error",
    "promise/no-multiple-resolved": "error",
    "promise/no-promise-in-callback": "error",

    // Don't escape the type system: `any` and narrowing casts are TypeScript's `unsafe`.
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "effecttsgo/unsafe-effect-type-assertion": "error",
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-check": false,
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "minimumDescriptionLength": 10
      }
    ],

    // Don't do potentially incorrect things with numbers.
    "typescript/restrict-plus-operands": "error",
    "typescript/require-array-sort-compare": "error",
    "unicorn/prefer-number-properties": "error",
    "eslint/radix": "error",

    // Don't do bad things that are easy to avoid.
    "eslint/no-new": "error",
    "eslint/no-warning-comments": "error",
    "directives/require-reason": "error",
    "typescript/no-deprecated": "error",
    "typescript/switch-exhaustiveness-check": "error"
  },
  "overrides": [
    {
      "files": ["**/packages/*/src/**/*.ts"],
      "rules": {
        "exports/no-self-barrel-import": "error",
        "eslint/no-restricted-properties": [
          "error",
          // Library code never unwraps: each accessor below throws or leaves the caller's fiber.
          { "object": "Option", "property": "getOrThrow" },
          { "object": "Option", "property": "getOrThrowWith" },
          { "object": "Result", "property": "getOrThrow" },
          { "object": "Result", "property": "getOrThrowWith" },
          { "object": "UndefinedOr", "property": "getOrThrow" },
          { "object": "UndefinedOr", "property": "getOrThrowWith" },
          { "object": "Array", "property": "getUnsafe" },
          { "object": "Context", "property": "getUnsafe" },
          { "object": "Effect", "property": "runSync" },
          { "object": "Effect", "property": "runSyncExit" },
          { "object": "Effect", "property": "runPromise" },
          { "object": "Effect", "property": "runPromiseExit" },
          { "object": "Effect", "property": "runFork" },
          // Effect's crypto-random-uuid follows the global `crypto` and its aliases, but not
          // `self.crypto`, element access, `.call` or destructuring, so the property itself is
          // restricted.
          {
            "property": "randomUUID",
            "message": "Draw a UUID from the Effect `Crypto` service the Layer captured."
          }
        ]
      }
    },
    {
      // Size limits for library code. A module over 600 lines, or a function over 150, does more
      // than one job; the function limit falls to 100 as the exceptions below go. Only code
      // counts, not blank lines or comments.
      "files": ["**/packages/*/src/**/*.ts"],
      "rules": {
        "eslint/max-lines": ["error", { "max": 600, "skipBlankLines": true, "skipComments": true }],
        "eslint/max-lines-per-function": [
          "error",
          { "max": 150, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    // The exceptions, each at its file's size when the limits came in. Lower a number when a change
    // shrinks its file, and never raise one; split the code instead. These are services built as
    // one closure over their state.
    {
      "files": ["**/packages/browser/src/internal/pictures/capture.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 290, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browserbase/src/BrowserbaseClient.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 237, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browser/src/Tools.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 226, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browser/src/internal/input/perform.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 194, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browser/src/Agent.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 161, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    // Parts of the page script. Each is one function because the page receives it as source text;
    // a new page-side feature is a new part.
    {
      "files": ["**/packages/browser/src/internal/input/guard.inpage.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 410, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browser/src/internal/reading/outline.inpage.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 181, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browser/src/internal/reading/names.inpage.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 221, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/browser/src/internal/input/targets.inpage.ts"],
      "rules": {
        "eslint/max-lines-per-function": [
          "error",
          { "max": 194, "skipBlankLines": true, "skipComments": true }
        ]
      }
    },
    {
      "files": ["**/packages/*/src/**/internal/**/*.ts"],
      "rules": { "exports/no-internal-barrel": "error" }
    },
    {
      "files": ["**/packages/*/src/**/index.ts"],
      "rules": { "exports/public-entrypoint": "error" }
    },
    {
      // Tests, the bench and the demo site drive the platform itself: they serve pages, launch
      // Chromium, read their environment, write records and fetch replays. They may also unwrap,
      // cast and use `any`-typed test utilities; a wrong guess fails the run.
      "files": [
        "**/packages/*/test/**/*.ts",
        "**/bench/**/*.ts",
        "**/demos/**/*.ts",
        "**/demos/**/*.tsx"
      ],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/crypto-random-uuid-in-effect": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-console-in-effect": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-fetch-in-effect": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/instance-of-schema": "off",
        "effecttsgo/new-promise": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/prefer-schema-over-json": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/process-env-in-effect": "off",
        "effecttsgo/schema-sync": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      // The bench's own program runs on Effect's platform: its configuration, files, child
      // processes, clock, randomness and console come from Effect's services.
      "files": ["**/bench/*.ts"],
      "rules": {
        "effecttsgo/async-function": "error",
        "effecttsgo/crypto-random-uuid": "error",
        "effecttsgo/crypto-random-uuid-in-effect": "error",
        "effecttsgo/global-console": "error",
        "effecttsgo/global-console-in-effect": "error",
        "effecttsgo/global-date": "error",
        "effecttsgo/global-fetch": "error",
        "effecttsgo/global-fetch-in-effect": "error",
        "effecttsgo/global-random": "error",
        "effecttsgo/global-timers": "error",
        "effecttsgo/new-promise": "error",
        "effecttsgo/node-builtin-import": "error",
        "effecttsgo/process-env": "error",
        "effecttsgo/process-env-in-effect": "error"
      }
    },
    {
      // The latency proxy and the hosted relay speak WebSocket over Node's sockets on host
      // timers, until a shared testing wire replaces them.
      "files": ["**/bench/Latency.ts", "**/bench/Relay.ts"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/crypto-random-uuid": "off",
        "effecttsgo/crypto-random-uuid-in-effect": "off",
        "effecttsgo/global-console": "off",
        "effecttsgo/global-console-in-effect": "off",
        "effecttsgo/global-date": "off",
        "effecttsgo/global-fetch": "off",
        "effecttsgo/global-fetch-in-effect": "off",
        "effecttsgo/global-random": "off",
        "effecttsgo/global-timers": "off",
        "effecttsgo/new-promise": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/process-env": "off",
        "effecttsgo/process-env-in-effect": "off"
      }
    }
  ]
}
