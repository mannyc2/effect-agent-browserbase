{
  "name": "effect-agent-browserbase-repository",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bench",
    "demos"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "patch:tsgo": "effect-tsgo patch --typescript --oxlint",
    "postinstall": "bun run patch:tsgo",
    "fmt": "vp fmt packages bench demos lint vite.config.ts",
    "fmt:check": "vp fmt --check packages bench demos lint vite.config.ts",
    "lint": "oxlint -c lint/.oxlintrc.json --deny-warnings --report-unused-disable-directives-severity=error packages bench demos",
    "check": "bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build",
    "size": "tools/check-size.sh",
    "ready": "bun run fmt:check && bun run lint && bun run size && bun run check && bun run test && bun run build"
  },
  "devDependencies": {
    "@effect/tsgo": "0.51.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.1.2",
    "effect": "4.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3",
    "@yielded/agent": "file:.work/yielded-local/yielded-agent-0.1.0-beta.168.tgz"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
