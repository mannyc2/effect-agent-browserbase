{
  "name": "effect-browser",
  "version": "0.3.0-beta.24",
  "description": "Effect browser sessions, page control, screencast, moments and filming over Playwright and CDP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "workerd": {
        "@effect-browser/source": "./src/index.ts",
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "@effect-browser/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./Cdp": {
      "workerd": {
        "@effect-browser/source": "./src/internal/cdp/workerd.ts",
        "types": "./dist/internal/cdp/workerd.d.mts",
        "default": "./dist/internal/cdp/workerd.mjs"
      },
      "@effect-browser/source": "./src/Cdp.ts",
      "types": "./dist/Cdp.d.mts",
      "default": "./dist/Cdp.mjs"
    },
    "./timeline": {
      "@effect-browser/source": "./src/timeline/index.ts",
      "types": "./dist/timeline/index.d.mts",
      "default": "./dist/timeline/index.mjs"
    },
    "./presentation": {
      "@effect-browser/source": "./src/presentation/index.ts",
      "types": "./dist/presentation/index.d.mts",
      "default": "./dist/presentation/index.mjs"
    },
    "./walk": {
      "@effect-browser/source": "./src/walk/index.ts",
      "types": "./dist/walk/index.d.mts",
      "default": "./dist/walk/index.mjs"
    },
    "./policy": {
      "@effect-browser/source": "./src/policy/index.ts",
      "types": "./dist/policy/index.d.mts",
      "default": "./dist/policy/index.mjs"
    },
    "./supervisor": {
      "@effect-browser/source": "./src/supervisor/index.ts",
      "types": "./dist/supervisor/index.d.mts",
      "default": "./dist/supervisor/index.mjs"
    },
    "./testing": {
      "@effect-browser/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.mts",
      "default": "./dist/testing/index.mjs"
    },
    "./*": {
      "@effect-browser/source": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./internal/*": null,
    "./timeline/internal/*": null,
    "./presentation/internal/*": null,
    "./walk/internal/*": null,
    "./supervisor/internal/*": null,
    "./testing/internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run"
  },
  "devDependencies": {
    "@effect-browser/chromium": "workspace:*",
    "@effect/vitest": "4.1.2",
    "@types/node": "26.1.2",
    "effect": "4.1.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": "~4.1.2",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
