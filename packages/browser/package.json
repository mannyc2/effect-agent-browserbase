{
  "name": "effect-browser",
  "version": "0.2.0-beta.8",
  "description": "Shared Effect browser sessions, modeled control and capture with an isolated Chromium launcher.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./bootstrap": "./src/Bootstrap.ts",
    "./browser": "./src/Browser.ts",
    "./browser-data": "./src/BrowserData.ts",
    "./browser-runtime": "./src/BrowserRuntime.ts",
    "./capture": "./src/Capture.ts",
    "./capture-data": "./src/CaptureData.ts",
    "./chromium": "./src/Chromium.ts",
    "./errors": "./src/Errors.ts",
    "./page-control": "./src/PageControl.ts",
    "./plan": "./src/Plan.ts",
    "./plan-data": "./src/PlanData.ts",
    "./testing": "./src/Testing.ts",
    "./timeline": "./src/Timeline.ts",
    "./timeline-data": "./src/TimelineData.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "install:test-browser": "playwright-core install --with-deps chromium",
    "test:native": "vp test --config vite.native.config.ts --run"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "26.1.2",
    "effect": "4.0.0-rc.117",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.117",
    "playwright-core": "1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
