{
  "name": "effect-browser",
  "version": "0.3.0-beta.0",
  "description": "Effect browser sessions, page control, screencast and agent tools over Playwright and CDP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": {
      "@effect-browser/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "@effect-browser/source": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./internal/*": null,
    "./index": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "26.1.2",
    "effect": "4.0.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
