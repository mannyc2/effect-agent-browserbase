{
  "name": "effect-browser",
  "version": "0.3.0-beta.0",
  "description": "Effect browser sessions, page control, screencast and agent tools over Playwright and CDP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/browser"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": {
      "@effect-browser/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./Agent": {
      "@effect-browser/source": "./src/Agent.ts",
      "types": "./dist/Agent.d.mts",
      "default": "./dist/Agent.mjs"
    },
    "./Browser": {
      "@effect-browser/source": "./src/Browser.ts",
      "types": "./dist/Browser.d.mts",
      "default": "./dist/Browser.mjs"
    },
    "./BrowserError": {
      "@effect-browser/source": "./src/BrowserError.ts",
      "types": "./dist/BrowserError.d.mts",
      "default": "./dist/BrowserError.mjs"
    },
    "./BrowserEvent": {
      "@effect-browser/source": "./src/BrowserEvent.ts",
      "types": "./dist/BrowserEvent.d.mts",
      "default": "./dist/BrowserEvent.mjs"
    },
    "./Cdp": {
      "@effect-browser/source": "./src/Cdp.ts",
      "types": "./dist/Cdp.d.mts",
      "default": "./dist/Cdp.mjs"
    },
    "./Chromium": {
      "@effect-browser/source": "./src/Chromium.ts",
      "types": "./dist/Chromium.d.mts",
      "default": "./dist/Chromium.mjs"
    },
    "./Frame": {
      "@effect-browser/source": "./src/Frame.ts",
      "types": "./dist/Frame.d.mts",
      "default": "./dist/Frame.mjs"
    },
    "./Moment": {
      "@effect-browser/source": "./src/Moment.ts",
      "types": "./dist/Moment.d.mts",
      "default": "./dist/Moment.mjs"
    },
    "./Motion": {
      "@effect-browser/source": "./src/Motion.ts",
      "types": "./dist/Motion.d.mts",
      "default": "./dist/Motion.mjs"
    },
    "./Page": {
      "@effect-browser/source": "./src/Page.ts",
      "types": "./dist/Page.d.mts",
      "default": "./dist/Page.mjs"
    },
    "./Plan": {
      "@effect-browser/source": "./src/Plan.ts",
      "types": "./dist/Plan.d.mts",
      "default": "./dist/Plan.mjs"
    },
    "./Policy": {
      "@effect-browser/source": "./src/Policy.ts",
      "types": "./dist/Policy.d.mts",
      "default": "./dist/Policy.mjs"
    },
    "./Snapshot": {
      "@effect-browser/source": "./src/Snapshot.ts",
      "types": "./dist/Snapshot.d.mts",
      "default": "./dist/Snapshot.mjs"
    },
    "./Supervisor": {
      "@effect-browser/source": "./src/Supervisor.ts",
      "types": "./dist/Supervisor.d.mts",
      "default": "./dist/Supervisor.mjs"
    },
    "./Tools": {
      "@effect-browser/source": "./src/Tools.ts",
      "types": "./dist/Tools.d.mts",
      "default": "./dist/Tools.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "26.1.2",
    "effect": "4.0.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
