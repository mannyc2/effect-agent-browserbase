{
  "name": "effect-browserbase",
  "version": "0.2.0-beta.8",
  "description": "Effect-based Browserbase resources and hosted integration for effect-browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/browserbase"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./account": "./src/Account.ts",
    "./agents": "./src/Agents.ts",
    "./allocation": "./src/Allocation.ts",
    "./browser": "./src/Browser.ts",
    "./browser-binding": "./src/BrowserBinding.ts",
    "./certificates": "./src/Certificates.ts",
    "./cleanup": "./src/Cleanup.ts",
    "./client": "./src/Client.ts",
    "./context-coordination": "./src/ContextCoordination.ts",
    "./contexts": "./src/Contexts.ts",
    "./downloads": "./src/Downloads.ts",
    "./errors": "./src/Errors.ts",
    "./extensions": "./src/Extensions.ts",
    "./functions": "./src/Functions.ts",
    "./launch": "./src/Launch.ts",
    "./page-fetch": "./src/PageFetch.ts",
    "./projects": "./src/Projects.ts",
    "./recordings": "./src/Recordings.ts",
    "./references": "./src/References.ts",
    "./replays": "./src/Replays.ts",
    "./search": "./src/Search.ts",
    "./session-data": "./src/SessionData.ts",
    "./sessions": "./src/Sessions.ts",
    "./testing": "./src/Testing.ts",
    "./transfers": "./src/Transfers.ts",
    "./uploads": "./src/Uploads.ts",
    "./webhooks": "./src/Webhooks.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "install:test-browser": "playwright-core install --with-deps chromium",
    "test:native": "vp test --config vite.native.config.ts --run"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0-rc.117",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "26.1.2",
    "effect": "4.0.0-rc.117",
    "effect-browser": "workspace:*",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite-plus": "0.3.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.117",
    "effect-browser": "workspace:*"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
