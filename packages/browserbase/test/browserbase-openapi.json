                          "enum": ["browserbase"]
                        },
                        "geolocation": {
                          "type": "object",
                          "properties": {
                            "city": {
                              "type": "string"
                            },
                            "state": {
                              "type": "string",
                              "maxLength": 2,
                              "minLength": 2,
                              "pattern": "^[A-Za-z]{2}$"
                            },
                            "country": {
                              "type": "string",
                              "maxLength": 2,
                              "minLength": 2,
                              "pattern": "^[A-Za-z]{2}$"
                            }
                          },
                          "required": ["country"]
                        },
                        "domainPattern": {
                          "type": "string"
                        }
                      },
                      "required": ["type"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["external"]
                        },
                        "server": {
                          "type": "string"
                        },
                        "domainPattern": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        }
                      },
                      "required": ["type", "server"]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": ["none"]
                        },
                        "domainPattern": {
                          "type": "string"
                        }
                      },
                      "required": ["type"]
                    }
                  ]
                }
              },
              {
                "type": "boolean"
              }
            ]
          },
          "proxySettings": {
            "type": "object",
            "properties": {
              "caCertificates": {
                "type": "array",
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "default": []
              }
            }
          },
          "region": {
            "type": "string",
            "default": "us-west-2",
            "enum": ["us-west-2", "us-east-1", "eu-central-1", "ap-southeast-1"]
          },
          "userMetadata": {
            "type": "object",
            "additionalProperties": true,
            "properties": {}
          }
        }
