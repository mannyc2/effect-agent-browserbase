                  "format": "date-time"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "status": {
                  "type": "string",
                  "enum": ["PENDING", "RUNNING", "ERROR", "TIMED_OUT", "COMPLETED"]
                },
                "proxyBytes": {
                  "type": "integer"
                },
                "keepAlive": {
                  "type": "boolean"
                },
                "contextId": {
                  "type": "string"
                },
                "region": {
                  "type": "string",
                  "enum": ["us-west-2", "us-east-1", "eu-central-1", "ap-southeast-1"]
                },
                "userMetadata": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {}
                }
              },
              "required": [
                "id",
                "createdAt",
                "updatedAt",
                "projectId",
                "status",
                "proxyBytes",
                "keepAlive",
                "region",
                "startedAt",
                "expiresAt"
