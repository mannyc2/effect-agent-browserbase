            }
          },
          "timeout": {
            "type": "integer",
            "maximum": 21600,
            "minimum": 60,
            "x-stainless-param": "api_timeout"
          },
          "keepAlive": {
            "type": "boolean"
          },
          "proxies": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
