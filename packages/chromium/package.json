{
  "name": "@effect-browser/chromium",
  "version": "0.3.0-beta.25",
  "description": "A local Chromium for effect-browser, launched through playwright-core.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/chromium"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@effect-browser/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./*": {
      "@effect-browser/source": "./src/*.ts",
      "types": "./dist/*.d.mts",
      "default": "./dist/*.mjs"
    },
    "./internal/*": null,
    "./index": null,
    "./*/index": null
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vp test --run"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "26.1.2",
    "effect": "4.1.2",
    "effect-browser": "workspace:*",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": "~4.1.2",
    "effect-browser": "^0.3.0-beta.25",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
