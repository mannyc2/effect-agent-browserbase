{
  "name": "@effect-agent/platform-browserbase",
  "version": "0.1.0-beta.102",
  "description": "Execution-scoped Browserbase browser control and independent browser artifacts for Effect Agent.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mannyc2/effect-agent-browserbase.git",
    "directory": "packages/platform-browserbase"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [],
  "exports": {
    ".": "./src/index.ts",
    "./interactive-browser": "./src/InteractiveBrowser.ts",
    "./types": "./src/Types.ts",
    "./tools": "./src/Tools.ts",
    "./recordings": "./src/Recordings.ts",
    "./replays": "./src/Replays.ts",
    "./downloads": "./src/Downloads.ts",
    "./capture": "./src/Capture.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit -p tsconfig.json",
    "install:test-browser": "playwright-core install --with-deps chromium",
    "example:agent": "bun examples/agent.ts",
    "example:hosted": "bun examples/hosted.ts",
    "example:record-video": "bun examples/record-video.ts",
    "test:native": "vp test --config vite.native.config.ts --run"
  },
  "dependencies": {
    "effect-agent": "workspace:*"
  },
  "devDependencies": {
    "@effect-agent/testing": "workspace:*",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "effect": "catalog:",
    "playwright-core": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.0-rc.115",
    "playwright-core": "1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
