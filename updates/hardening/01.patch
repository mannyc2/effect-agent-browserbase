diff --git a/packages/platform-browserbase/src/internal/References.ts b/packages/platform-browserbase/src/internal/References.ts
new file mode 100644
index 0000000..5135325
--- /dev/null
+++ b/packages/platform-browserbase/src/internal/References.ts
@@ -0,0 +1,25 @@
+import { Effect, Schema } from "effect";
+import { BrowserbaseError, RecordingPageReference, SessionReference } from "../Types.ts";
+
+/** Own scalar identities before the first asynchronous authorization request.
+ * A retained Schema.Class instance is still mutable through JavaScript reflection. */
+export const ownSessionReference = (input: SessionReference) => Effect.try({
+  try: () => ({ provider: input.provider, projectId: input.projectId, sessionId: input.sessionId }),
+  catch: () => new BrowserbaseError({ operation: "session-identity", reason: "malformed" }),
+}).pipe(
+  Effect.flatMap(Schema.decodeEffect(SessionReference)),
+  Effect.map((value) => Object.freeze(value)),
+  Effect.mapError(() => new BrowserbaseError({ operation: "session-identity", reason: "malformed" })),
+);
+
+export const ownPageReference = Effect.fnUntraced(function* (input: RecordingPageReference) {
+  const scalars = yield* Effect.try({
+    try: () => ({ session: input.session, pageId: input.pageId }),
+    catch: () => new BrowserbaseError({ operation: "recording-identity", reason: "malformed" }),
+  });
+  const session = yield* ownSessionReference(scalars.session);
+  return yield* Schema.decodeEffect(RecordingPageReference)({ session, pageId: scalars.pageId }).pipe(
+    Effect.map((value) => Object.freeze(value)),
+    Effect.mapError(() => new BrowserbaseError({ operation: "recording-identity", reason: "malformed" })),
+  );
+});
